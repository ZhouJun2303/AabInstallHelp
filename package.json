{
  "name": "AabInstalllHelp",
  "icon": "resources/icon.png",
  "version": "1.0.4",
  "description": "aab ",
  "main": "main.js",
  "scripts": {
    "start": "npm run pre_asset_mac && electron .",
    "start_win": "npm run pre_asset_win && chcp 65001 & electron .",
    "clean_assets": "rm -rf ./assets",
    "pre_asset_mac": "rm -rf ./assets && cp -r ./assets_common/ ./assets && cp -r ./bin_mac/ ./assets",
    "pre_asset_win": "scripts\\pre_asset_win.bat",
    "elepack": "electron-packager . --overwrite",
    "elebuild_mac": "npm run pre_asset_mac && electron-builder --publish never",
    "elebuild_win": "npm run pre_asset_win && electron-builder --publish never",
    "pack_and_update": "pack_and_update.bat"
  },
  "keywords": [
    "start",
    "elebuild"
  ],
  "build": {
    "productName": "AabInstalllHelp",
    "appId": "com.fireantzhang.aabinstallhelp",
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "files": [
      "index.html",
      "main.js",
      "process.js",
      "handle_drag.js",
      "style.css",
      "update_util.js"
    ],
    "mac": {
      "asar": false,
      "category": "aab install help tool",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "publish": [],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhouJun2303/AabInstallHelp.git"
  },
  "homepage": "https://github.com/ZhouJun2303/AabInstallHelp",
  "author": "fireantzhang",
  "license": "ISC",
  "devDependencies": {
    "builder-util": "^21.2.0",
    "electron": "^7.1.6",
    "electron-builder": "^21.2.0",
    "electron-packager": "^14.1.1"
  },
  "dependencies": {
    "jquery": "^3.4.1",
    "xmlreader": "^0.2.3"
  }
}
